    "@fontsource/playfair-display": "^5.3.0",
    "@rlm/adapters": "workspace:*",
    "@rlm/contracts": "workspace:*",
    "@rlm/core": "workspace:*",
    "@rlm/hub": "workspace:*",
    "@rlm/inference": "workspace:*",
    "@rlm/team": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
