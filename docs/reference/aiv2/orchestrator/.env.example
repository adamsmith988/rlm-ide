# Orchestrator Service Configuration
# تنظیمات سرویس ارکستراتور

# ==================== Debug ====================
DEBUG=true

# ==================== LLM gateway ====================
# OpenAI-compatible llm-gateway (in-cluster or local)
LLM_PROXY_URL=http://localhost:8005
STRICT_LLM_BINDINGS=true
# Model ids: configure llm_routes in Storage (see docs/llm-control-plane.md)
# Auth to gateway: INTERNAL_API_KEY (Bearer / X-Internal-Key)
INTERNAL_API_KEY=
LLM_TEMPERATURE=0.1
# Leave unset for no output cap; set only if you need a hard limit (e.g. 8192)
# LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120

# ==================== Tool Runner ====================
# آدرس سرویس tool-runner
TOOL_RUNNER_URL=http://localhost:8002
TOOL_RUNNER_TIMEOUT=60

# ==================== Memory (mem0) ====================
# فعال/غیرفعال کردن حافظه
MEM0_ENABLED=false

# تنظیمات Qdrant برای vector store
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ==================== Native Corpus RAG ====================
# Preflight ANN on Storage collection tool_embed_text + rerank via llm-proxy.
# Bind models in Admin: service.orchestrator.rag_embed / service.orchestrator.rag_rerank
NATIVE_RAG_ENABLED=true
NATIVE_RAG_TOP_K=5
NATIVE_RAG_CANDIDATE_LIMIT=25
NATIVE_RAG_SCORE_THRESHOLD=0.3
NATIVE_RAG_COLLECTION=tool_embed_text
NATIVE_RAG_TIMEOUT_S=20
NATIVE_RAG_MAX_CHARS_PER_HIT=1200

# ==================== Agent Settings ====================
# حداکثر تعداد گام‌ها در هر اجرای agent
MAX_STEPS=3

# حداکثر تعداد ابزارهای موازی
MAX_PARALLEL_TOOLS=5

# ==================== Storage ====================
# آدرس سرویس storage (اختیاری)
STORAGE_URL=http://localhost:8004
