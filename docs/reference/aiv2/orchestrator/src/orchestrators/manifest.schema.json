{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aiv2.orchestrator.manifest.v1",
  "title": "AIv2 Orchestrator Manifest",
  "description": "Forward-compatible qualification contract for drop-in orchestrators / agent harnesses.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "kind",
    "lifecycle",
    "runtime",
    "operations",
    "host_ports"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Manifest schema major version. Bump only with a normalizer."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "Open vocabulary (agent_harness, search_controller, coding_agent, …)."
    },
    "lifecycle": {
      "type": "string",
      "enum": ["one_shot", "session", "daemon"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["in_process", "subprocess", "controller"]
        },
        "wire": {
          "type": "string",
          "description": "Open vocabulary (python_api, jsonl_rpc, cli, …)."
        }
      }
    },
    "memory": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "host_ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean", "default": false }
        }
      }
    },
    "input_schema": { "type": "object", "additionalProperties": true },
    "output_schema": { "type": "object", "additionalProperties": true },
    "config_schema": { "type": "object", "additionalProperties": true },
    "settings_ui": {
      "type": "array",
      "description": "Consumer-agnostic settings form defs (AF-style param objects).",
      "items": { "type": "object", "additionalProperties": true }
    },
    "tools_binding": {
      "type": "object",
      "additionalProperties": true,
      "description": "How this engine accepts host catalog tools. Host resolves which tools; engine declares delivery mode.",
      "properties": {
        "mode": {
          "type": "string",
          "description": "Open vocabulary: openai_functions | kernel_callable | …"
        },
        "config_key": {
          "type": "string",
          "description": "Envelope config key for tool id allowlist (e.g. tool_ids)."
        },
        "host_port": {
          "type": "string",
          "description": "HostPorts id used for execution (usually tools)."
        },
        "selection": {
          "type": "string",
          "description": "host_provided | host_turn — who chooses the allowlist."
        },
        "surface": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "namespace": { "type": "string" },
            "call_pattern": { "type": "string" }
          }
        }
      }
    },
    "session_binding": {
      "type": "object",
      "additionalProperties": true,
      "description": "How the host should retain engine memory across chat turns. Engines declare; hosts implement.",
      "properties": {
        "mode": {
          "type": "string",
          "description": "Open vocabulary: durable | ephemeral_turn | …"
        },
        "key_from": {
          "type": "string",
          "description": "Host key source for engine session identity (e.g. chat_session_id)."
        },
        "engine_session_prefix": {
          "type": "string",
          "description": "Prefix for stable engine session ids derived from the host key."
        },
        "first_op": {
          "type": "string",
          "description": "Operation for the first turn (usually run)."
        },
        "next_op": {
          "type": "string",
          "description": "Operation for subsequent turns (usually continue)."
        },
        "stores": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Memory stores the engine keeps when durable (session, kernel, harness, …)."
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "resource": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "weight": { "type": "number", "minimum": 0 },
        "max_parallel": { "type": "integer", "minimum": 1 },
        "timeout_sec": { "type": "number", "minimum": 0 }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "description": { "type": "string" },
    "api_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Run envelope API version (create/run/continue/status)."
    }
  }
}
