{
  "schema_version": 1,
  "api_version": 1,
  "id": "rrsi",
  "name": "RRSI (Regularized Recursive Self-Improvement)",
  "version": "1.0.0",
  "kind": "search_controller",
  "description": "Regularized recursive self-improvement of the agent harness (Google Research, 2026). Each chat turn runs RRSI rounds on the conversation's own requests: analyze the incumbent's judged trials, draft m candidate harness edits under an annealed L0 budget with exploration/pruning directives, screen them with a leakage critic, evaluate them, and accept only candidates that clear the noise-adjusted floor and the cost rule. The user gets the best-judged answer of the accepted harness. Defaults follow the paper except k (trials per task) and the replay set size, which are reduced for interactive cost.",
  "lifecycle": "session",
  "runtime": { "kind": "controller", "wire": "python_api" },
  "memory": ["session", "durable"],
  "capabilities": ["stream", "ensemble_search", "harness_refine", "tools"],
  "operations": ["create", "run", "continue", "search", "select", "status", "shutdown", "events"],
  "depends_on": [],
  "host_ports": [
    { "id": "chat", "required": true },
    { "id": "events", "required": false }
  ],
  "session_binding": {
    "mode": "durable",
    "key_from": "chat_session_id",
    "first_op": "run",
    "next_op": "continue",
    "stores": ["session", "durable"]
  },
  "artifacts": [],
  "resource": { "weight": 8, "max_parallel": 2 },
  "input_schema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "question": { "type": "string" },
      "context_messages": { "type": "array" }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "text": { "type": "string" },
      "harness": { "type": "object" },
      "rounds": { "type": "array" }
    }
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "T": { "type": "integer", "minimum": 1 },
      "k": { "type": "integer", "minimum": 1 },
      "m": { "type": "integer", "minimum": 1 },
      "b_min": { "type": "integer", "minimum": 1 },
      "b_max": { "type": "integer", "minimum": 1 },
      "w": { "type": "integer", "minimum": 1 },
      "m_draft": { "type": "integer", "minimum": 0 },
      "delta": { "type": ["number", "null"] },
      "delta_z": { "type": "number" },
      "delta_floor": { "type": "number" },
      "beta0": { "type": "number" },
      "beta1": { "type": "number" },
      "w_s": { "type": "number" },
      "w_c": { "type": "number" },
      "w_n": { "type": "number" },
      "n_prune": { "type": "integer", "minimum": 0 },
      "repair_rounds": { "type": "integer", "minimum": 0 },
      "invalid_missing_frac": { "type": "number" },
      "n_fail_traces": { "type": "integer", "minimum": 0 },
      "n_success_traces": { "type": "integer", "minimum": 0 },
      "eval_parallel": { "type": "integer", "minimum": 1 },
      "policy_engine": { "type": "string" },
      "policy_config": { "type": "object" },
      "rounds_per_turn": { "type": "integer", "minimum": 0 },
      "replay_turns": { "type": "integer", "minimum": 0 },
      "replay_max_request_chars": { "type": "integer", "minimum": 0 },
      "role_text_max_chars": { "type": "integer", "minimum": 0 },
      "trial_parallel": { "type": "integer", "minimum": 1 },
      "trial_timeout_sec": { "type": "integer", "minimum": 0 },
      "proposer_max_turns": { "type": "integer", "minimum": 1 },
      "role_temperature": { "type": "number" },
      "role_max_tokens": { "type": "integer", "minimum": 0 },
      "role_enable_thinking": { "type": "boolean" },
      "judge_temperature": { "type": "number" },
      "judge_max_tokens": { "type": "integer", "minimum": 0 },
      "json_retries": { "type": "integer", "minimum": 1 },
      "rubric_min_criteria": { "type": "integer", "minimum": 1 },
      "rubric_max_criteria": { "type": "integer", "minimum": 1 },
      "leak_ngram": { "type": "integer", "minimum": 0 },
      "frozen_engine_keys": { "type": "array" },
      "contract_policy_keys": { "type": "array" },
      "estimate_tokens_when_missing": { "type": "boolean" },
      "chars_per_token": { "type": "number" },
      "history_render_rows": { "type": "integer", "minimum": 1 },
      "initial_harness": { "type": "object" },
      "show_round_log": { "type": "boolean" }
    }
  },
  "settings_ui": [
    { "name": "policy_engine", "type": "string", "label": "Policy engine id (empty = default chat engine)", "label_fa": "موتور سیاست (خالی = موتور پیش‌فرض)", "default": "", "options_source": "orchestrators?capability=stream" },
    { "name": "policy_config", "type": "json", "label": "Policy engine base settings", "label_fa": "تنظیمات پایهٔ موتور سیاست", "default": {}, "advanced": true },
    { "name": "rounds_per_turn", "type": "int", "label": "RRSI rounds per chat turn (0 = serve the current harness only)", "label_fa": "تعداد دور در هر نوبت (۰ = فقط اجرا)", "default": 1, "min": 0, "max": 10 },
    { "name": "replay_turns", "type": "int", "label": "Earlier requests replayed in the evolve set", "label_fa": "تعداد درخواست‌های قبلی در مجموعهٔ تکامل", "default": 1, "min": 0, "max": 20 },
    { "name": "replay_max_request_chars", "type": "int", "label": "Skip replaying earlier requests longer than this (chars, 0 = no limit)", "label_fa": "سقف طول درخواست قبلی برای بازپخش (۰ = بدون سقف)", "default": 8000, "min": 0, "advanced": true },
    { "name": "role_text_max_chars", "type": "int", "label": "Max request / answer chars shown to the judge (0 = no limit)", "label_fa": "سقف طول درخواست و پاسخ برای داور (۰ = بدون سقف)", "default": 6000, "min": 0, "advanced": true },
    { "name": "T", "type": "int", "label": "Horizon T (rounds; budget anneals over it)", "label_fa": "افق T", "default": 20, "min": 1, "max": 200, "advanced": true },
    { "name": "k", "type": "int", "label": "Trials per task k", "label_fa": "تعداد آزمایش برای هر کار", "default": 1, "min": 1, "max": 8 },
    { "name": "m", "type": "int", "label": "Candidates per round m", "label_fa": "تعداد نامزد در هر دور", "default": 2, "min": 1, "max": 8 },
    { "name": "b_min", "type": "int", "label": "Min edit budget b_min", "label_fa": "حداقل بودجهٔ ویرایش", "default": 1, "min": 1, "max": 8, "advanced": true },
    { "name": "b_max", "type": "int", "label": "Max edit budget b_max", "label_fa": "حداکثر بودجهٔ ویرایش", "default": 4, "min": 1, "max": 8, "advanced": true },
    { "name": "w", "type": "int", "label": "Stall window w", "label_fa": "پنجرهٔ توقف", "default": 3, "min": 1, "max": 20, "advanced": true },
    { "name": "m_draft", "type": "int", "label": "Reserved exploration slots", "label_fa": "جایگاه‌های اکتشاف", "default": 1, "min": 0, "max": 8, "advanced": true },
    { "name": "delta", "type": "float", "label": "Noise band delta (empty = calibrate)", "label_fa": "باند نویز (خالی = کالیبره)", "default": null, "advanced": true },
    { "name": "delta_z", "type": "float", "label": "Calibration z", "label_fa": "z کالیبراسیون", "default": 2.0, "advanced": true },
    { "name": "delta_floor", "type": "float", "label": "Minimum noise band", "label_fa": "حداقل باند نویز", "default": 0.05, "min": 0.0, "max": 1.0, "advanced": true },
    { "name": "beta0", "type": "float", "label": "Cost rule beta0", "label_fa": "beta0", "default": 0.10, "advanced": true },
    { "name": "beta1", "type": "float", "label": "Cost rule beta1", "label_fa": "beta1", "default": 40.0, "advanced": true },
    { "name": "w_s", "type": "float", "label": "Shaped rule w_s", "label_fa": "w_s", "default": 100.0, "advanced": true },
    { "name": "w_c", "type": "float", "label": "Shaped rule w_c", "label_fa": "w_c", "default": 15.0, "advanced": true },
    { "name": "w_n", "type": "float", "label": "Shaped rule w_n", "label_fa": "w_n", "default": 0.5, "advanced": true },
    { "name": "n_prune", "type": "int", "label": "Prune window n_prune", "label_fa": "پنجرهٔ هرس", "default": 4, "min": 0, "advanced": true },
    { "name": "repair_rounds", "type": "int", "label": "Critic repair rounds", "label_fa": "دورهای اصلاح منتقد", "default": 5, "min": 0, "max": 10, "advanced": true },
    { "name": "invalid_missing_frac", "type": "float", "label": "Max missing-trial fraction", "label_fa": "حداکثر کسر آزمایش‌های ناقص", "default": 0.15, "advanced": true },
    { "name": "n_fail_traces", "type": "int", "label": "Failure traces analyzed", "label_fa": "ردهای شکست", "default": 22, "min": 0, "advanced": true },
    { "name": "n_success_traces", "type": "int", "label": "Success traces analyzed", "label_fa": "ردهای موفق", "default": 6, "min": 0, "advanced": true },
    { "name": "eval_parallel", "type": "int", "label": "Candidates evaluated in parallel", "label_fa": "ارزیابی هم‌زمان نامزدها", "default": 1, "min": 1, "max": 8, "advanced": true },
    { "name": "trial_parallel", "type": "int", "label": "Policy trials in parallel", "label_fa": "آزمایش‌های هم‌زمان", "default": 2, "min": 1, "max": 16, "advanced": true },
    { "name": "trial_timeout_sec", "type": "int", "label": "Timeout per policy trial (sec, 0 = none)", "label_fa": "مهلت هر آزمایش", "default": 600, "min": 0, "advanced": true },
    { "name": "proposer_max_turns", "type": "int", "label": "Proposer protocol turns", "label_fa": "نوبت‌های پیشنهاددهنده", "default": 6, "min": 1, "max": 40, "advanced": true },
    { "name": "role_temperature", "type": "float", "label": "Analyst / proposer / critic temperature", "label_fa": "دمای نقش‌ها", "default": 0.3, "advanced": true },
    { "name": "role_max_tokens", "type": "int", "label": "Role max tokens (0 = model default)", "label_fa": "سقف توکن نقش‌ها", "default": 4096, "min": 0, "advanced": true },
    { "name": "role_enable_thinking", "type": "boolean", "label": "Model thinking for roles", "label_fa": "فکر مدل برای نقش‌ها", "default": false, "advanced": true },
    { "name": "judge_temperature", "type": "float", "label": "Judge temperature", "label_fa": "دمای داور", "default": 0.0, "advanced": true },
    { "name": "judge_max_tokens", "type": "int", "label": "Judge max tokens (0 = model default)", "label_fa": "سقف توکن داور", "default": 2048, "min": 0, "advanced": true },
    { "name": "json_retries", "type": "int", "label": "Re-asks on invalid JSON", "label_fa": "تکرار برای JSON نامعتبر", "default": 3, "min": 1, "max": 10, "advanced": true },
    { "name": "rubric_min_criteria", "type": "int", "label": "Rubric min criteria", "label_fa": "حداقل معیار", "default": 3, "min": 1, "max": 20, "advanced": true },
    { "name": "rubric_max_criteria", "type": "int", "label": "Rubric max criteria", "label_fa": "حداکثر معیار", "default": 7, "min": 1, "max": 30, "advanced": true },
    { "name": "leak_ngram", "type": "int", "label": "Leakage n-gram length (0 = off)", "label_fa": "طول n-gram نشت", "default": 8, "min": 0, "max": 40, "advanced": true },
    { "name": "frozen_engine_keys", "type": "json", "label": "Policy settings the proposer may not change", "label_fa": "تنظیمات قفل‌شده", "default": ["model", "agent_model", "compact_model", "tool_ids", "run_lifetime", "daemon_enabled", "heartbeat_interval_sec", "heartbeat_prompt"], "advanced": true },
    { "name": "contract_policy_keys", "type": "json", "label": "Policy settings over the contract API (host chat policy)", "label_fa": "تنظیمات سیاست در API قرارداد", "default": ["temperature", "top_p", "max_tokens"], "advanced": true },
    { "name": "estimate_tokens_when_missing", "type": "boolean", "label": "Estimate cost from answer length when the engine reports no tokens", "label_fa": "تخمین هزینه از طول پاسخ", "default": true, "advanced": true },
    { "name": "chars_per_token", "type": "float", "label": "Characters per token (estimate)", "label_fa": "کاراکتر به ازای توکن", "default": 4.0, "advanced": true },
    { "name": "history_render_rows", "type": "int", "label": "History rows shown to the proposer", "label_fa": "ردیف‌های تاریخچه", "default": 40, "min": 1, "advanced": true },
    { "name": "initial_harness", "type": "json", "label": "Initial harness H_0 (empty = schema defaults)", "label_fa": "هارنس اولیه", "default": {}, "advanced": true },
    { "name": "show_round_log", "type": "boolean", "label": "Show the round log in the process panel", "label_fa": "نمایش لاگ دورها", "default": true, "advanced": true }
  ],
  "extensions": {
    "chat_stream": true,
    "stream_entry": "src.orchestrators.rrsi.chat_stream:stream_agent_rrsi",
    "wraps_engines": true,
    "reference": {
      "code": "https://github.com/google-research/rrsi",
      "license": "Apache-2.0 (core vendored under rrsi/core)"
    }
  }
}
