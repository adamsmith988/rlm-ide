# =============================================================================
# Tool Runner Service Configuration
# =============================================================================

# Service settings
DEBUG=false
HOST=0.0.0.0
PORT=8002

# Tools module path (original AI tools)
TOOLS_MODULE_PATH=/app/modules/tools
PLUGINS_MODULE_PATH=/app/modules/plugins
# TOOLS_MANIFEST_PATH=/app/data/tool_manifest.py

# llm-proxy — فقط tool-runner به آن وصل می‌شود (فوروارد از /internal/llm/*)
LLM_PROXY_URL=http://llm-proxy:8005
LLM_FORWARD_TIMEOUT_SEC=540
LLM_EMBED_FORWARD_TIMEOUT_SEC=120
LLM_IMAGE_FORWARD_TIMEOUT_SEC=600
# صبر در صف llm-proxy = timeout بلند روی همان connection (نه retry روی 503)
LLM_INFRA_RETRY_MAX_ATTEMPTS=3
LLM_INFRA_RETRY_DELAY_SEC=1
LLM_VALIDATION_CACHE_TTL_SEC=120
# Agent-flow RLM streaming turns go straight to llm-gateway (no loopback
# double-hop through this uvicorn). Defaults to LLM_PROXY_URL; set an explicit
# base URL to override, or "off" to force the legacy /internal/llm/* path.
# AGENT_FLOW_RLM_LLM_URL=http://llm-proxy:8005

# ابزارها به این آدرس می‌زنند (همان کانتینر: loopback)
TOOL_LLM_GATEWAY_URL=http://127.0.0.1:8002
# اجباری اگر پورت tool-runner به میزبان باز است؛ باید با مقدار زیر در همین سرویس یکی باشد
TOOL_RUNNER_INTERNAL_SECRET=aiv2-dev-internal-llm-change-in-prod

# RBAC: cache impersonated effective-permission lookups (seconds; <=0 disables)
TOOL_RUNNER_RBAC_EFFECTIVE_CACHE_TTL_SEC=10
TOOL_RUNNER_RBAC_EFFECTIVE_CACHE_MAX_ENTRIES=4096

# Storage service for persistence
STORAGE_URL=http://storage:8004

# Data directories
UPLOAD_DIR=/data/uploads
MODELS_DIR=/data/models

# Tool execution settings
TOOL_TIMEOUT_DEFAULT=120
# Agent-flow admission control: global cap on running flows + per-user cap.
# Runs over capacity are accepted with progress status "queued" (+ position).
TOOL_MAX_CONCURRENT=8
AGENT_FLOW_MAX_CONCURRENT_PER_USER=2
# Graceful shutdown drain (SIGTERM): wait for running flows, then snapshot RLM
# sessions, then cancel leftovers. Sum (+ uvicorn --timeout-graceful-shutdown 30)
# must stay below k8s terminationGracePeriodSeconds=600.
AGENT_FLOW_DRAIN_TIMEOUT_SEC=450
AGENT_FLOW_DRAIN_SESSION_TIMEOUT_SEC=60
AGENT_FLOW_DRAIN_CANCEL_TIMEOUT_SEC=20

# Shared run bus (Phase 2). Uses REDIS_URL (below). When set: run lease
# (worker_id / lease_expires_at / cancel_requested / queue_position) + the last
# coalesced progress snapshot live in Redis hash agent_flow:run:{run_id}, frames
# are published on the same-named channel for SSE fan-out across replicas, and
# cancels are fanned in via agent_flow:ctl. Unset REDIS_URL → process-local
# (identical to Phase 1). Set AGENT_FLOW_REDIS_URL=off to disable only the bus.
# AGENT_FLOW_REDIS_URL=off
AGENT_FLOW_BUS_COALESCE_SEC=1
AGENT_FLOW_LEASE_TTL_SEC=30
AGENT_FLOW_BUS_SNAPSHOT_TTL_SEC=900
# AGENT_FLOW_WORKER_ID=tool-runner-0   # default: $HOSTNAME:$PID

# Horizontal scale (Phase 3). Single image; role selects the process behaviour:
#   all    = serve HTTP + execute heavy tools in-process (default, legacy)
#   api    = serve HTTP; heavy tools are queued to Redis (needs REDIS_URL)
#   worker = serve HTTP + consume heavy jobs from the Redis queue
TOOL_RUNNER_ROLE=all
# Heavy / detached tool pool (src/heavy_tools.py): comma-separated tool ids
# that are accepted immediately, run detached under admission control and are
# dispatched to worker pods when ROLE=api. plugin_agent_flow_run is always in.
TOOL_RUNNER_HEAVY_TOOL_IDS=plugin_agent_flow_run
# Unset → queue/owner map disabled (role=all keeps working exactly as before).
# REDIS_URL=redis://redis:6379/0
AGENT_FLOW_QUEUE_KEY=agent_flow:queue
# Owner map agent_flow:owner:{run_id} → pod: lease TTL, refresh period, and how
# long the pointer lingers after the run ends (progress is process-local).
AGENT_FLOW_OWNER_TTL_SEC=90
AGENT_FLOW_OWNER_HEARTBEAT_SEC=30
AGENT_FLOW_OWNER_LINGER_SEC=900
# Identity written to the owner map; k8s sets this from status.podIP.
# AGENT_FLOW_POD_IDENTITY=10.42.0.17
AGENT_FLOW_WORKER_POLL_SEC=5
AGENT_FLOW_WORKER_BUSY_BACKOFF_SEC=1

# Resource cleanup
CLEANUP_ON_IDLE=true
IDLE_TIMEOUT_SEC=300

# CORS
CORS_ORIGINS=*
