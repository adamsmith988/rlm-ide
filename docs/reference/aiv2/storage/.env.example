# Storage Service Configuration
# سرویس ذخیره‌سازی - پیکربندی

# PostgreSQL (Required)
DATABASE_URL=postgresql://user:password@localhost:5432/aiv2

# MongoDB (Optional - for flexible document storage)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=aiv2

# Qdrant Vector DB (Optional - for vector search)
QDRANT_URL=http://localhost:6333

# Upload directory
UPLOAD_DIR=./data/uploads

# Embedding model for text indexing
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
